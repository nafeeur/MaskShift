# Core
MASKSHIFT_MODEL=ollama:auto
MASKSHIFT_HOME=~/.maskshift
MASKSHIFT_HOST=127.0.0.1
MASKSHIFT_PORT=4242
# MASKSHIFT_CONFIG=/absolute/path/to/config.json
# MASKSHIFT_DEBUG=1

# Local and OpenAI-compatible endpoints
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
VLLM_BASE_URL=http://127.0.0.1:8000/v1

# Provider credentials
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
VLLM_API_KEY=

# Optional native web/integration tools
GITHUB_TOKEN=
BRAVE_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
