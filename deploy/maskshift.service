[Unit]
Description=MaskShift automation daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
Environment=MASKSHIFT_HOME=%h/.maskshift
EnvironmentFile=-%h/.config/maskshift/env
# The daemon runs no interface; it keeps scheduled automations firing.
# Use the `maskshift` command in a terminal for the TUI.
ExecStart=%h/.local/bin/maskshift daemon --workspace %h
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillMode=mixed

# Deliberately no ProtectSystem/PrivateNetwork sandboxing: overdrive tools need the
# same host authority as the user running this service.

[Install]
WantedBy=default.target
